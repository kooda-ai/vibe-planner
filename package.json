{
  "name": "vibe-planner",
  "version": "0.1.0",
  "private": true,
  "main": "dist-electron/main.js",
  "description": "AI project planner: turn an idea into phases and paste them into your vibe coder.",
  "author": "Vibe Planner",
  "repository": {
    "type": "git",
    "url": "https://github.com/kooda-ai/vibe-planner.git"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "test": "playwright test --config playwright-dyad.config.ts",
    "build:next": "next build",
    "build:electron": "node scripts/build-electron.mjs",
    "build:standalone": "npm run build:next && node scripts/prepare-standalone.mjs",
    "desktop": "concurrently -k -n next,electron -c cyan,magenta \"next dev\" \"wait-on tcp:3000 && npm run build:electron && electron .\"",
    "dist": "npm run build:standalone && npm run build:electron && electron-builder",
    "dist:dir": "npm run build:standalone && npm run build:electron && electron-builder --dir --publish never"
  },
  "dependencies": {
